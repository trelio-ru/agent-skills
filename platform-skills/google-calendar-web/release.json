{
  "schemaVersion": 2,
  "release": {
    "skillId": "google-calendar-web",
    "version": "0.1.2",
    "summary": "Цифровые ассистенты могут работать с Google Календарём через отдельную защищённую сессию и проверяемые сценарии",
    "routingSummary": "Read Google Calendar schedules and manage events through the managed browser without the Google Calendar API."
  },
  "connection": {
    "schemaVersion": 1,
    "intro": [
      "Войдите в Google в отдельном видимом Chromium Trelio. Аккаунт из встроенного браузера Codex и личного Chrome не импортируется.",
      "После успешного входа окно закроется автоматически, а авторизация сохранится локально в защищённом снимке. Если готовый Календарь не распознан, можно закрыть окно или сообщить «готово». Обычная работа идёт без окна."
    ],
    "configFields": [],
    "secretFields": []
  },
  "runtime": {
    "version": "0.1.2",
    "minimumHostVersion": "3.32.0",
    "entrypoint": {
      "path": "trelio-google-calendar.mjs",
      "interpreter": "node"
    },
    "capabilities": [
      "browser",
      "local-session",
      "network",
      "local-accounts-v1"
    ],
    "browserSession": {
      "apiVersion": 1,
      "sessionClass": "protected-snapshot",
      "manualAssist": true
    },
    "files": [
      {
        "source": "scripts/trelio-google-calendar.mjs",
        "path": "trelio-google-calendar.mjs",
        "mode": 493
      },
      {
        "source": "scripts/calendar-workflows.mjs",
        "path": "calendar-workflows.mjs",
        "mode": 420
      },
      {
        "source": "scripts/trelio-assistant-execution.json",
        "path": "trelio-assistant-execution.json",
        "mode": 420
      },
      {
        "source": "scripts/trelio-secret-setup.json",
        "path": "trelio-secret-setup.json",
        "mode": 420
      },
      {
        "source": "scripts/instruction-guides/part-01.md",
        "path": "instruction-guides/part-01.md",
        "mode": 420
      },
      {
        "source": "scripts/instruction-guides/part-02.md",
        "path": "instruction-guides/part-02.md",
        "mode": 420
      }
    ]
  }
}
