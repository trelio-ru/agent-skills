{
  "schemaVersion": 2,
  "release": {
    "skillId": "telegram-mtproto",
    "version": "2.5.0",
    "summary": "Полный обход чатов Telegram вне архива с пагинацией, проверкой изменений списка и возобновляемым экспортом периода. Результат отдельно показывает охват чатов, непрочитанные участки сообщений и вложения без прочитанного содержимого."
  },
  "connection": {
    "schemaVersion": 1,
    "intro": [
      "Каждый пользователь входит в свой Telegram-аккаунт локально. Личная сессия остаётся на его устройстве."
    ],
    "configFields": [],
    "deprecatedConfigKeys": [
      "apiId",
      "allowAutonomous"
    ],
    "secretFields": []
  },
  "runtime": {
    "version": "2.5.0",
    "minimumHostVersion": "1.11.0",
    "entrypoint": {
      "path": "trelio-telegram.py",
      "interpreter": "python"
    },
    "capabilities": [
      "local-session",
      "network"
    ],
    "files": [
      {
        "source": "scripts/trelio-telegram.py",
        "path": "trelio-telegram.py",
        "mode": 493
      },
      {
        "sourceEnvironment": "TRELIO_TELEGRAM_APP_CREDENTIAL_JSON",
        "releaseInputExposure": "package-recipient",
        "path": "telegram-app-credentials.json",
        "mode": 420
      }
    ]
  }
}
