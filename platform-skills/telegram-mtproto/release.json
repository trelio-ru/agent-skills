{
  "schemaVersion": 2,
  "release": {
    "skillId": "telegram-mtproto",
    "version": "2.6.0",
    "summary": "Несколько личных аккаунтов с названиями и комментариями, выбором для каждой компании и сохранением существующих подключений."
  },
  "connection": {
    "schemaVersion": 1,
    "intro": [
      "Каждый пользователь входит в свой Telegram-аккаунт локально. Личная сессия остаётся на его устройстве."
    ],
    "configFields": [],
    "deprecatedConfigKeys": [
      "apiId",
      "allowAutonomous"
    ],
    "secretFields": []
  },
  "runtime": {
    "version": "2.6.0",
    "minimumHostVersion": "3.7.0",
    "entrypoint": {
      "path": "trelio-telegram.py",
      "interpreter": "python"
    },
    "capabilities": [
      "local-session",
      "network",
      "local-accounts-v1"
    ],
    "files": [
      {
        "source": "scripts/trelio-telegram.py",
        "path": "trelio-telegram.py",
        "mode": 493
      },
      {
        "sourceEnvironment": "TRELIO_TELEGRAM_APP_CREDENTIAL_JSON",
        "releaseInputExposure": "package-recipient",
        "path": "telegram-app-credentials.json",
        "mode": 420
      }
    ]
  }
}
